# Salin ke .env.local lalu isi. Jangan pernah mengarahkan .env.local ke database produksi:
# migrasi, seed, dan smoke test menulis ke database yang ditunjuk DATABASE_URL.

# Wajib
DATABASE_URL="postgresql://postgres@localhost:5432/dproduction?schema=public"

# Wajib untuk dashboard /management. Isi string acak panjang, misalnya hasil: openssl rand -base64 32
JWT_SECRET=""

# SEO (opsional). Kosong berarti memakai https://dproduction-iota.vercel.app
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Google Ads (opsional). Kosong berarti tag dan konversi tidak dikirim.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_WA_CONVERSION_LABEL=""

# Notifikasi lead baru ke Telegram (opsional)
LEAD_TELEGRAM_BOT_TOKEN=""
LEAD_TELEGRAM_CHAT_ID=""

# Seed akun bawaan (opsional). Kosong berarti password acak dibuat dan dicetak sekali.
SEED_PASSWORD=""
