# Salin ke .env.local lalu isi. Jangan pernah mengarahkan .env.local ke database produksi:
# migrasi, seed, skrip isi konten, dan smoke test menulis ke database yang ditunjuk DATABASE_URL.
# Penjelasan tiap variabel ada di README bagian Variabel lingkungan.

# Runtime, wajib. Contoh untuk Postgres.app di port 5433.
DATABASE_URL="postgresql://postgres@localhost:5433/dproduction?schema=public"

# Runtime, wajib untuk dashboard /management. String acak minimal 32 karakter, misalnya hasil: openssl rand -hex 32
JWT_SECRET=""

# Runtime, opsional. Folder gambar unggahan; kosong berarti folder uploads di root proyek.
UPLOAD_DIR=""

# Runtime, opsional. Notifikasi lead baru ke Telegram; kalau salah satu kosong, notifikasi tidak dikirim.
LEAD_TELEGRAM_BOT_TOKEN=""
LEAD_TELEGRAM_CHAT_ID=""

# Build, opsional. Nilainya tertanam di hasil build, jadi hanya data publik dan perlu build ulang setelah diubah.
# NEXT_PUBLIC_SITE_URL kosong berarti memakai https://www.dpro.events
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Build, opsional. Google Ads; kosong berarti tag dan konversi tidak dikirim.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_WA_CONVERSION_LABEL=""

# Seed lokal, opsional. Minimal 8 karakter berisi huruf dan angka; kosong berarti password acak dibuat dan dicetak sekali.
SEED_PASSWORD=""
